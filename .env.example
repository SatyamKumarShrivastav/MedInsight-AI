# MedInsight AI — Environment Configuration Example
# BioIntelliX | Team led by Mr. S. K. Shrivastav
# Copy to .env and fill in your actual values. NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MedInsight AI
APP_VERSION=1.0.0
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Seeded account passwords (required only when running seed scripts) ────────
# Set distinct, strong values; these are never printed by the seed scripts.
MEDINSIGHT_CEO_PASSWORD=SET-A-UNIQUE-CEO-PASSWORD
MEDINSIGHT_ADMIN_PASSWORD=SET-A-UNIQUE-ADMIN-PASSWORD
MEDINSIGHT_RESEARCHER_PASSWORD=SET-A-UNIQUE-RESEARCHER-PASSWORD
MEDINSIGHT_STUDENT_PASSWORD=SET-A-UNIQUE-STUDENT-PASSWORD
MEDINSIGHT_TRIAL_RESEARCHER_PASSWORD=SET-A-UNIQUE-TRIAL-RESEARCHER-PASSWORD
MEDINSIGHT_EVALUATOR_PASSWORD=SET-A-UNIQUE-EVALUATOR-PASSWORD
MEDINSIGHT_DOCTOR_PASSWORD=SET-A-UNIQUE-DOCTOR-PASSWORD
MEDINSIGHT_COLLEGE_STUDENT_PASSWORD=SET-A-UNIQUE-COLLEGE-STUDENT-PASSWORD
MEDINSIGHT_WORKFLOW_CITIZEN_PASSWORD=SET-A-UNIQUE-WORKFLOW-CITIZEN-PASSWORD
MEDINSIGHT_WORKFLOW_APPROVED_PASSWORD=SET-A-UNIQUE-WORKFLOW-APPROVED-PASSWORD

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=medinsight_ai

# ── File Storage ──────────────────────────────────────────────────────────────
# Paths are relative to the project root, or set absolute paths
UPLOAD_DIR=uploads
ARTIFACT_DIR=artifacts
REPORT_DIR=reports

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional: LLM Provider (Research Assistant Enhancement) ───────────────────
# Leave blank to use offline TF-IDF retrieval mode (no paid API required)
LLM_PROVIDER=none
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# ── Optional: Vector Database (for RAG) ───────────────────────────────────────
# Leave blank to use SQLite-based keyword retrieval
VECTOR_DB=none
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8001
